# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large media kept out of git.
# GitHub rejects files over 100MB, and these are served from external hosting.
# introduction.mp4 (106MB) and clients/q-fest.mp4 (59MB) are referenced by the app;
# upload them to Vercel Blob / Cloudinary and point the code at those URLs.
# The remaining reels are not referenced anywhere in src/.
/public/videos/**/*.mp4
/public/videos/*.mp4
